# Backend API
REACT_APP_API_URL=http://localhost:8000

# Supabase (anon key is meant to be public — but DO NOT commit your real .env)
# Get these from your Supabase project settings: https://supabase.com/dashboard
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Note: ensure Row Level Security (RLS) is enabled on all tables that the anon key can access.
# The anon key is publicly distributed in client-side bundles by design — security relies on RLS policies.
